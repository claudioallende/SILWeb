<!DOCTYPE html>
<html lang="es-es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - S.I.L.</title>
    <link rel="icon" type="image/x-icon" href="~/Content/images/favicon.png" />
    @Styles.Render("~/Content/bootstrap")
    @Styles.Render("~/Content/css")
    @Styles.Render("~/Content/open-iconic-bootstrap.min.css")
    @RenderSection("Styles", required: false)

</head>
<body>
    <nav class="navbar navbar-expand-lg fixed-top navbar-dark bg-blue">
        <div class="container">
            <div>
                <img src="~/Content/images/logo.png" class="logo" />
                @Html.ActionLink("Sistema Integral de Logística", "Index", "Cupos", new { area = "" }, new { @class = "navbar-brand ml-1" })
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                @Html.Partial("_LoginPartial")
            </div>
        </div>
    </nav>
    <div class="container-fluid body-content">
        <!--[if lt IE 9]>
            <div style="width: 100%; display: block; padding: 10px 18px; border: 2px solid; font-size: 1rem; font-weight: bold; margin: 8px 6px;">
                Sistema Integral de Logística Cliente (SIL) puede no visualizarse correctamente en Internet Explorer.
            </div>
        <![endif]-->
        @RenderBody()
    </div>
    <script>
        model_layout = {
            actionExistenPendietes: "@Url.Action("ExistenCuposPendientes", "Cupos")"
        }
    </script>

    <!-- Scripts utilitarios -->
    <script src="~/Scripts/Functions.js"></script>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/NotificacionCuposStopPendientes")
    @RenderSection("scripts", required: false)
</body>
</html>
