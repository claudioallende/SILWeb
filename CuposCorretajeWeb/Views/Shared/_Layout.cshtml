<!DOCTYPE html>
<html lang="es-es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - S.I.L.</title>
    <link rel="icon" type="image/x-icon" href="~/Content/images/favicon.png" />
    @Styles.Render("~/Content/bootstrap")
    @Styles.Render("~/Content/css")
    @Styles.Render("~/Content/open-iconic-bootstrap.min.css")
    @RenderSection("Styles", required: false)
    <link rel="stylesheet" href="@Url.Content("~/Content/vendor/font-awesome/all.min.css")" />
</head>
<body>
    <nav class="navbar navbar-expand-lg fixed-top navbar-dark bg-blue">
        <div class="container">
            <div>
                <img src="~/Content/images/logo.png" class="logo" />
                @Html.ActionLink("Sistema Integral de Logística", "Index", "Cupos", new { area = "" }, new { @class = "navbar-brand ml-1" })
            </div>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                @Html.Partial("_LoginPartial")
            </div>
        </div>
    </nav>
    <div class="container-fluid body-content">
        <!-- Loader AJAX Global -->
        <div id="loader" class="d-none position-fixed top-0 start-0 w-100 h-100 flex-column justify-content-center align-items-center bg-white" style="z-index: 9999;">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden"></span>
            </div>
            <p class="mt-3 text-primary">Cargando, por favor espere...</p>
        </div>
        <!--[if lt IE 9]>
        <div style="width: 100%; display: block; padding: 10px 18px; border: 2px solid; font-size: 1rem; font-weight: bold; margin: 8px 6px;">
            Sistema Integral de Logística Cliente (SIL) puede no visualizarse correctamente en Internet Explorer.
        </div>
    <![endif]-->
        @RenderBody()
    </div>
    <script>
        model_layout = {
            actionExistenPendietes: "@Url.Action("ExistenCuposPendientes", "Cupos")"
        }
    </script>

    <!-- Scripts utilitarios -->
    <script src="~/Scripts/Functions.js"></script>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/NotificacionCuposStopPendientes")
    <!-- SweetAlert2 -->
    <script src="@Url.Content("~/Scripts/vendor/sweetalert2/sweetalert2.min.js")"></script>
    <script type="text/javascript">
        // Verificaci&oacute;n de carga de SweetAlert2. Si por alg&uacute;n motivo
        // el archivo local no se sirvi&oacute; (404, MIME type, error de IIS), Swal
        // queda undefined y todos los Swal.fire() del proyecto degradan a un
        // toast nativo con texto plano (es lo que vimos en el caso reportado).
        //
        // Esto escribe un mensaje claro en la consola del browser para que el
        // operador pueda diagnosticar sin tener que abrir DevTools.
        (function () {
            function checkSwal() {
                if (typeof Swal !== 'undefined') {
                    console.log('[SIL] SweetAlert2 OK, version:', Swal.version);
                } else {
                    console.error('[SIL] SweetAlert2 NO se carg&oacute;. Revisar Network tab para 404 en /Scripts/vendor/sweetalert2/sweetalert2.min.js. Fallback a alert() nativo.');
                    // &Uacute;ltimo recurso: si Swal nunca lleg&oacute;, exponer un
                    // wrapper m&iacute;nimo basado en alert() para que al menos el
                    // operador VEA el mensaje y no se rompa el flujo. Esto es
                    // un degradado consciente, no el comportamiento por defecto
                    // de SweetAlert2 (que muestra texto plano sin formato).
                    window.Swal = {
                        fire: function (opts) {
                            var icon = (opts && opts.icon) || 'info';
                            var title = (opts && opts.title) || '';
                            var text = (opts && opts.text) || (opts && opts.html ? '[Contenido HTML]' : '');
                            var msg = (title ? title + '\n\n' : '') + text;
                            // try/catch por si el navegador bloquea alert() (caso raro).
                            try { alert(msg); } catch (e) { console.error('[SIL] alert() bloqueado:', msg); }
                            // Devolver una Promise resuelta para que .then(...) siga funcionando.
                            return Promise.resolve({ isConfirmed: true, isDismissed: false });
                        }
                    };
                }
            }
            // Si el <script> ya termin&oacute; de parsear, Swal deber&iacute;a estar
            // definido. Si no lo est&aacute;, es porque fall&oacute; la carga.
            if (document.readyState === 'complete' || document.readyState === 'interactive') {
                checkSwal();
            } else {
                document.addEventListener('DOMContentLoaded', checkSwal);
            }
        })();
    </script>
    <script type="text/javascript">
        function ShowLoader() {
            $('#loader').removeClass('d-none').addClass('d-flex');
            $('#loader').fadeIn(300);
        }

        function HideLoader() {
            $('#loader').removeClass('d-flex').addClass('d-none');
            $('#loader').fadeOut(300);
        }
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
