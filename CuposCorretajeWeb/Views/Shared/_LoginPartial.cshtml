@using Microsoft.AspNet.Identity
@if (Request.IsAuthenticated)
{
    using (Html.BeginForm("Signout", "Account", FormMethod.Post, new { id = "logoutForm", @class = "form-inline my-2 my-lg-0 ml-auto" }))
    {
        @Html.AntiForgeryToken()

        <ul class="navbar-nav">
            <li class="nav-item">
                <span class="nav-link">Usuario: @User.Identity.GetUserName()</span>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("", "")" title="Principal">
                    <span class="oi oi-home" style="font-size:1.25em;"></span>
                </a>
            </li>
            <li class="nav-item position-relative">
                <a class="nav-link" href="@Url.Action("AutorizacionesPendientes", "Cupos")" id="navAutorizacionesPendientes" role="button" aria-haspopup="true" aria-expanded="false" title="Autorizaciones Pendientes STOP">
                    <span class="oi oi-data-transfer-download" style="font-size:1.25em;"></span>
                    <div class="notification_counter">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200">
                            <style type="text/css">
                                /*  */
                                circle {
                                    fill: red;
                                    stroke: white;
                                    stroke-width: 10px;
                                    // Note that the value of a pixel depend on the viewBox;
                                }
                                /*  */
                            </style>
                            <circle r="60" cy="100" cx="100"></circle>
                        </svg>
                    </div>
                </a>
            </li>
            @if (CuposCorretajeWeb.Models.Identity.ClaimsUtil.HasSomeClaim(new System.Collections.Generic.List<string> { "AccesoAuditoriaCuposCorretaje", "AccesoConfiguracionCorretaje" }))
            {
                <li class="nav-item dropdown">
                    <a class="nav-link" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <span class="oi oi-magnifying-glass" style="font-size:1.25em;"></span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                        <a class="dropdown-item" href="@Url.Action("Turno", "Cupos")" title="Buscar Turnos">Turnos</a>
                        @if (CuposCorretajeWeb.Models.Identity.ClaimsUtil.HasClaim("AccesoAuditoriaCuposCorretaje"))
                        {
                            <a class="dropdown-item" href="@Url.Action("Index", "Auditoria")" title="Buscar Auditoría">Auditoría</a>
                        }
                    </div>
                </li>
            }
            else
            {
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Turno", "Cupos")" title="Buscar Turnos">
                        <span class="oi oi-magnifying-glass" style="font-size:1.25em;"></span>
                    </a>
                </li>
            }
            <li class="nav-item dropdown">
                <a class="nav-link" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <span class="oi oi-cog" style="font-size:1.25em;"></span>
                </a>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    <a class="dropdown-item" href="@Url.Action("Email","Configuracion")">Email</a>
                    <a class="dropdown-item" href="@Url.Action("CuentaCYO","Configuracion")">Cuenta CYO</a>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item" href="@Url.Action("CentroPuertoStop","Configuracion")">Centro por Puerto STOP</a>
                    <a class="dropdown-item" href="@Url.Action("GranoStop","Configuracion")">Granos STOP</a>
                    <a class="dropdown-item" href="@Url.Action("RelacionGranoStop","Configuracion")">Relaciones Granos STOP</a>
					<div class="dropdown-divider"></div>
                    <a class="dropdown-item" href="@Url.Action("PuertoStop","Configuracion")">Puertos STOP</a>
                    <a class="dropdown-item" href="@Url.Action("RelacionPuertoStop","Configuracion")">Relaciones Puertos STOP</a>
                    @if (CuposCorretajeWeb.Models.Identity.ClaimsUtil.HasClaim("AccesoConfiguracionCuposCorretaje"))
                    {
                        <a class="dropdown-item" href="@Url.Action("Index", "Configuracion")" title="Configuración">Configuración</a>
                    }
                </div>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="javascript:document.getElementById('logoutForm').submit()" title="Cerrar sesión">
                    <span class="oi oi-account-logout" style="font-size:1.25em;"></span>
                </a>
            </li>
        </ul>
    }
}
else
{
    <ul class="navbar-nav ml-auto">
        <li class="nav-item">@Html.ActionLink("Iniciar sesión", "Login", "Account", routeValues: null, htmlAttributes: new { id = "loginLink", @class = "nav-link" })</li>
    </ul>
}
