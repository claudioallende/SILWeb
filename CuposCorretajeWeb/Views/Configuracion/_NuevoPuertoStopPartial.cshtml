@model CuposCorretajeWeb.Models.PuertoStop
@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "formPuerto" }))
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.NroPuerto, htmlAttributes: new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.NroPuerto, new { @class = "form-control" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(model => model.NombrePuerto, htmlAttributes: new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.NombrePuerto, new { @class = "form-control" })
                </div>
            </div>
        </div>

        <div class="form-group">
            <div class="row">
                <div class="col-md-12 text-right">
                    @{
                        var permiso_escritura = CuposCorretajeWeb.Models.Identity.ClaimsUtil.GetClaimValue(User, "AccesoConfiguracionCYOeEmailDeCuentasCuposCorretaje");
                    }
                    <input type="submit" value="Aceptar" class="btn btn-primary" id="btnAgregarPuerto"
                           @if (permiso_escritura != "True") {   @: disabled
                    } />
                </div>
            </div>
        </div>
    </div>
}
