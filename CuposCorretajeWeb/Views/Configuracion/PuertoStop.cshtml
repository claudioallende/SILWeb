@model CuposCorretajeWeb.Models.PuertoStopViewModel

@{
    ViewBag.Title = "Puerto STOP";
}

<h2>Puerto STOP</h2>

<div style="width:60%; margin: auto" id="main">
    <div class="text-right mb-2">
        <button class="btn btn-primary" data-toggle="modal" data-target="#modal-nuevo" id="btnAgregar">Agregar</button>
    </div>

    <table id="tablaPuertos" class="table text-center table-striped table--fixed table-id table-wrap-bordered">
        <thead>
            <tr>
                <th>Código Stop</th>
                <th>Nombre</th>
                <th style="width: 230px"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var Puerto in Model.ListaPuertosStop)
            {
                <tr id="puerto-@Puerto.NroPuerto">
                    <td>@Puerto.NroPuerto</td>
                    <td style="text-align:left">@Puerto.NombrePuerto</td>
                    <td>
                        <div style="display: inline-block">
                            <button class="btn btn-warning px-3 btn-upd text-white" data-id="@Puerto.NroPuerto">Modificar</button>
                            <button class="btn btn-danger btn-del" data-id="@Puerto.NroPuerto">Eliminar</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div id="modal-nuevo" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="">Nuevo</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                @Html.Partial("_NuevoPuertoStopPartial", Model.NuevoPuertoStop)
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script type="text/javascript">
        var model = {
            actionGetPuerto: "@Url.Action("GetPuertoStop", "Configuracion")",
            actionNuevoPuerto: "@Url.Action("NuevoPuertoStop", "Configuracion")",
            actionModificarPuerto: "@Url.Action("ModificarPuertoStop", "Configuracion")",
            actionEliminarPuerto: "@Url.Action("EliminarPuertoStop", "Configuracion")",
        }
    </script>

    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/Alert")
    @Scripts.Render("~/bundles/PuertoStop")
}
