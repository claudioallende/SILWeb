@model CuposCorretajeWeb.Models.NuevoCentroPorPuertoViewModel

@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "formRelacion" }))
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.IdOrNombrePuerto, htmlAttributes: new { @class = "control-label" })
                    @Html.EditorFor(model => model.IdOrNombrePuerto, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.HiddenFor(model => model.IdRelacion)
                    <div class="contenedor-nombre-cuenta text-right">
                        <span id="NombrePuerto" class="nombre-cuenta text-primary"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(model => model.CodigoOrNombreCentro, htmlAttributes: new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.CodigoOrNombreCentro, Model.Centros, new { @class = "form-control" })
                    <div class="contenedor-nombre-cuenta text-right">
                        <span id="NombreCentro" class="nombre-cuenta text-primary"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group">
            <div class="row">
                <div class="col-md-12 text-right">
                    @{
                        var permiso_escritura = CuposCorretajeWeb.Models.Identity.ClaimsUtil.GetClaimValue(User, "AccesoConfiguracionCYOeEmailDeCuentasCuposCorretaje");
                    }
                    <input type="submit" value="Aceptar" class="btn btn-primary" id="btnAgregarRelacion"
                        @if (permiso_escritura != "True")
                        {  
                            @:disabled 
                        } />
                </div>
            </div>
        </div>
    </div>
}
