              @Html.TextBoxEditableAtributoDisabledFor(model => model.Nomrtecomercial, new { @class = "form-control nombre-cuenta", id = "CuitrtecomercialName", data_cuitTarget = "Cuitrtecomercial", @disabled = string.IsNullOrEmpty(Model.NomrtecomercialDisabled) ? null : Model.NomrtecomercialDisabled })
              @Html.ValidationMessageFor(model => model.Nomrtecomercial, "", new { @class = "text-danger" })
            </div>
          </div>
        </div>

        <div class="form-row">
          <div class="col-md-4">
            <div class="form-group">
              @Html.LabelFor(model => model.Cuitmat)
              @Html.TextBoxEditableAtributoDisabledFor(model => model.Cuitmat, new { @class = "form-control cuit-cuenta", id = "Cuitmat", data_nombreTarget = "CuitmatName", @disabled = string.IsNullOrEmpty(Model.CuitmatDisabled) ? null : Model.CuitmatDisabled })
