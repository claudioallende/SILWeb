@model CuposCorretajeWeb.Models.NuevoCupoStopViewModel
@using CuposCorretajeWeb.Models.Vista

@{
  ViewBag.Title = "Autorización de Cupos";
}

@section Styles{
  @Styles.Render("~/Content/spinner")
  @Styles.Render("~/Content/autocompletecss")
  @Styles.Render("~/Content/WordTag")
  @Styles.Render("~/Content/highlightTextArea")
}

<h2>Autorización de Turnos</h2>

@using (Html.BeginForm("", "", FormMethod.Post, new { id = "FormNuevo" }))
{
  @Html.AntiForgeryToken()

  <div class="form-horizontal">
    <hr />
    @if (Model.Error != null && Model.Error != string.Empty)
    {
      <div class="alert alert-danger" role="alert">
        @Model.Error
      </div>
    }
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="row">
      <div class="col-md-4">
        <div class="form-group">
          @Html.LabelFor(model => model.Producto)
          @Html.DropDownListFor(model => model.Producto, new SelectList(Model.Productos, "NroGranoSIL", "nombreGranoSil", Model.Producto), new { @class = "form-control input-cuenta" })
          @Html.HiddenFor(model => model.Producto)
        </div>
      </div>

      <div class="col-md-4">
        <div class="form-group">
          @Html.LabelFor(model => model.Compcta)
          @Html.TextBoxEditableAtributoDisabledFor(model => model.Compcta, new { @class = "form-control input-cuenta", data_tipo = "Comprador", data_cuenta = Url.Action("GetCompradorFromNroCuentaOrNombre", "Cuenta"), @disabled = string.IsNullOrEmpty(Model.CompctaDisabled) ? null : Model.CompctaDisabled })
          <div class="contenedor-nombre-cuenta text-right">
            <span id="CompradorNombre" class="nombre-cuenta text-primary">@Model.CompradorNombre</span>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="form-group">
          @Html.LabelFor(model => model.Puerto)
          @Html.DropDownListFor(model => model.Puerto, new SelectList(Model.Puertos, "NroPuertoSIL", "nombrePuertoSil", Model.Puerto), new { @class = "form-control input-cuenta" })
          @Html.HiddenFor(model => model.Puerto)
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-4">
        <div class="form-group">
          @Html.LabelFor(model => model.Centro)
          @Html.DropDownListFor(model => model.Centro, Model.Centros, new { @class = "form-control" })
          @Html.ValidationMessageFor(model => model.Centro, "", new { @class = "text-danger" })
        </div>
      </div>

      <div class="col-md-4">
        <div class="form-group">
          @Html.LabelFor(model => model.Vendcta)
          @Html.TextBoxEditableAtributoDisabledFor(model => model.Vendcta, new { @class = "form-control input-cuenta", data_tipo = "Vendedor", data_cuenta = Url.Action("GetVendedorFromNroCuentaOrNombre", "Cuenta"), @disabled = string.IsNullOrEmpty(Model.VendctaDisabled) ? null : Model.VendctaDisabled })
          @Html.ValidationMessageFor(model => model.Vendcta, "", new { @class = "text-danger" })
          <div class="contenedor-nombre-cuenta text-right">
            <span id="VendedorNombre" class="nombre-cuenta text-primary">@Model.VendedorNombre</span>
          </div>
        </div>
      </div>

      <div id="VendcyoGroup" class="col-md-4 align-self-center">
        <div class="custom-control custom-checkbox">
          @Html.CheckBoxFor(model => model.VendcyoBoolValue, new { @class = "custom-control-input" })
