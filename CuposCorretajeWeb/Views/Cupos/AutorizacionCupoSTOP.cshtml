            </div>
          </div>
          <div class="col-lg-12">
            <div class="form-group">
              @Html.LabelFor(model => model.ContactoComercial)
              @Html.EditorFor(model => model.ContactoComercial, new { htmlAttributes = new { @class = "form-control" } })
            </div>
          </div>
          <div id="col-caratula" class="col-lg-12">
            <div class="form-group">
              @Html.LabelFor(model => model.Caratula)
              @Html.EditorFor(model => model.Caratula, new { htmlAttributes = new { @class = "form-control" } })
