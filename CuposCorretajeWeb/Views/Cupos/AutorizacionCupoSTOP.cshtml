              @Html.ValidationMessageFor(model => model.Nomcorrcomp, "", new { @class = "text-danger" })
            </div>
          </div>
        </div>

        <div class="form-row">
          <div class="col-md-4">
            <div class="form-group">
              @Html.LabelFor(model => model.Cuitrteent)
              @Html.TextBoxEditableAtributoDisabledFor(model => model.Cuitrteent, new { @class = "form-control cuit-cuenta", id = "Cuitrteent", data_nombreTarget = "CuitrteentName", @disabled = string.IsNullOrEmpty(Model.CuitrteentDisabled) ? null : Model.CuitrteentDisabled })
              @Html.ValidationMessageFor(model => model.Cuitrteent, "", new { @class = "text-danger" })
            </div>
          </div>

          <div class="col-md-8">
            <div class="form-group">
              @Html.LabelFor(model => model.Nomrteent)
              @Html.TextBoxEditableAtributoDisabledFor(model => model.Nomrteent, new { @class = "form-control nombre-cuenta", id = "CuitrteentName", data_cuitTarget = "Cuitrteent", @disabled = string.IsNullOrEmpty(Model.NomrteentDisabled) ? null : Model.NomrteentDisabled })
              @Html.ValidationMessageFor(model => model.Nomrteent, "", new { @class = "text-danger" })
            </div>
