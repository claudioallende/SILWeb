    <hr />
    <!--Alfanumericos por día-->
    <div class="row justify-content-between flex-row flex-nowrap row-scroll">
      @for (int Dia = 0; Dia <= Model.CantidadDias; Dia++)
      {
        <div id="codigos-dia-@Dia" class="col-2">
          <div class="form-group">
            @Html.HiddenFor(x => x.CodigosDias[Dia].Fecha, new { Value = DateTime.Now.AddDays(Dia).ToString("dd/MM/yy") })
            <div class="form-group">
              <div class="highlight-container">
                <div class="backdrop">
                  <div class="highlights"></div>
                </div>

                @Html.Partial("_ListaAlfanumericosSeleccionablesPartialView", Model.CodigosDias[Dia])

              </div>
            </div>
            <span class="aviso-repetido"><span class="highlight-repeated">(*)</span>Alfanuméricos repetidos</span>
          </div>
        </div>
      }
    </div>
    @*<div class="row justify-content-between flex-row flex-nowrap row-scroll">
          @for (int Dia = 0; Dia <= Model.CantidadDias; Dia++)
          {
              <div id="inputAlfas-" class="col-2">
                  <textarea class="form-control " rows="8"></textarea>
              </div>
          }
      </div>*@

    <div class="row">
