<!--Modal seleccion alfas-->
<div class="modal" id="modalAlfas" tabindex="-1" role="dialog" data-nrodia="">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <form id="formModalAlfas">
        <div class="modal-header">
          <h5 id="modalAlfasTitle" class="modal-title">Selección Alfanuméricos Día <span id="fechaModalAlfas"></span></h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <span>Alfanuméricos</span>
          <textarea class="seleccionAlfanumericos form-control" rows="8"></textarea>
        </div>
        <div class="modal-footer">
          <button class="btn btn-primary">Aceptar</button>
          <button type="button" class="btn btn-secondary" data-dismiss="modal" id="btnCerrarModal">Cerrar</button>
        </div>
      </form>
    </div>
  </div>
</div>

@section Scripts {
  @Scripts.Render("~/bundles/spinner")
  @Scripts.Render("~/bundles/jqueryval")
  @Scripts.Render("~/bundles/ValidaCuit")
  @Scripts.Render("~/bundles/autocompletejs")
  @Scripts.Render("~/bundles/ControlaInputs")
  @Scripts.Render("~/bundles/Alert")
  @Scripts.Render("~/bundles/WordTag")
  @Scripts.Render("~/bundles/Observable")
  <script type="text/javascript">
        window.modelData = {
            actionGetCuit: "@Url.Action("GetCuentaFromCuit", "Cuenta")",
            actionGetNombreCuenta: "@Url.Action("GetCuitFromNombre", "Cuenta")",
            actionGetNombreAndCuit: "@Url.Action("GetCuentaFromNumeroCuentaComprador", "Cuenta")",
            actionGetCuentaYOrdenByNumeroCuenta: "@Url.Action("GetCuentaYOrdenByNumeroCuenta", "Configuracion")",
            actionGetCuposCuitFromNroCuentaOrNombre: "@Url.Action("GetCuposCuitFromNroCuentaOrNombre", "Cuenta")",
            actionAutorizar: "@Url.Action("AutorizarStop", "Cupos")",
            actionCambiarCentro: "@Url.Action("CambiarCentroCupoPendienteStop", "Cupos")",
            actionPendientesAutorizar: "@Url.Action("AutorizacionesPendientes", "Cupos")",
            actionEsCYO: "@Url.Action("GetCuentaYOrdenByNumeroCuenta", "Configuracion")",
            actionGetContactoComercial: "@Url.Action("GetCuposCuitFromNroCuentaOrNombre", "Cuenta")",
            nuevoCupo: {}
        }

        var tokenfieldAlfas = $('.seleccionAlfanumericos').tokenfield({
            delimiter: ["\n", ","],
            inputType: "textarea",
            minWidth: "100%",
            minHeight: "100px"
        });

        document.getElementById("Centro").addEventListener("change", function (e) {
            onChangeCentro(e);
        });
  </script>
  @Scripts.Render("~/bundles/AutorizacionCuposStop")
  @Scripts.Render("~/bundles/highlightTextArea")
}
