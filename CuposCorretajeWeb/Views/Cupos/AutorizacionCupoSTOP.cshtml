        <div class="form-row">
          <div class="col-md-4">
            <div class="form-group">
              @Html.LabelFor(model => model.Cuitdestinatario)
              @Html.TextBoxEditableAtributoDisabledFor(model => model.Cuitdestinatario, new { @class = "form-control cuit-cuenta", id = "Cuitdestinatario", data_nombreTarget = "CuitdestinatarioName", @disabled = string.IsNullOrEmpty(Model.CuitdestinatarioDisabled) ? null : Model.CuitdestinatarioDisabled })
