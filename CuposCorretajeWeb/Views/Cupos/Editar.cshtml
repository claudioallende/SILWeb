@model CuposCorretajeWeb.Models.EditarCupoViewModel

@{
  ViewBag.Title = "Editar";
}

<h2>Editar</h2>


@using (Html.BeginForm("Editar", "Cupos", new { centroorigen = Request.Params["centroorigen"], centrodistribucion = Request.Params["centrodistribucion"], cyo = Request.Params["cyo"] }, FormMethod.Post, new { id = "FormEditar" }))
{
  @Html.AntiForgeryToken()
  <hr />
  @Html.ValidationSummary(true, "", new { @class = "text-danger" })
  <div class="row">
    <div class="col-md-3">
      <div class="form-group">
        @Html.LabelFor(model => model.Producto, htmlAttributes: new { @class = "control-label" })
        @Html.TextBoxFor(model => model.Producto, new { @class = "form-control", @readonly = "readonly" })
        @Html.ValidationMessageFor(model => model.Producto, "", new { @class = "text-danger" })
      </div>
    </div>

    <div class="col-md-3">
      <div class="form-group">
        @Html.LabelFor(model => model.Comprador, htmlAttributes: new { @class = "control-label" })
        @Html.TextBoxFor(model => model.Comprador, new { @class = "form-control", @readonly = "readonly" })
        @Html.ValidationMessageFor(model => model.Comprador, "", new { @class = "text-danger" })
      </div>
    </div>

    <div class="col-md-3">
      <div class="form-group">
        @Html.LabelFor(model => model.Vendedor, htmlAttributes: new { @class = "control-label" })
        @Html.TextBoxFor(model => model.Vendedor, new { @class = "form-control", @readonly = "readonly" })
        @Html.ValidationMessageFor(model => model.Vendedor, "", new { @class = "text-danger" })
      </div>
    </div>

    <div class="col-md-3">
      <div class="form-group">
        @Html.LabelFor(model => model.Puerto, htmlAttributes: new { @class = "control-label" })
        @Html.TextBoxFor(model => model.Puerto, new { @class = "form-control", @readonly = "readonly" })
        @Html.ValidationMessageFor(model => model.Puerto, "", new { @class = "text-danger" })
      </div>
    </div>
  </div>

  @Html.Partial("_ModalSeleccionConsignacionesPartial", Model.Consignaciones, new ViewDataDictionary
  {
      { "OpenModal", Model.ConsignacionSeleccionada == null ? true : false }
  })
}

<div class="row flex-row flex-nowrap row-scrollx">
  @for (int Dia = 0; Dia <= 20; Dia++)
  {
    <div class="col-md-2">
      @Html.Partial("_ListaAlfanumericosAnulablesPartialView", Model.ListaAlfanumerico[Dia])
    </div>
  }
</div>
<div class="row">
  <div class="col-sm-12 text-right">
    <button id="Editar" class="btn btn-primary" data-toggle="modal" disabled>Aceptar</button>
    @Html.ActionLink("Volver", "Detalle",
        new
        {
            id = Model.CuentaComprador + "-" + Model.CuentaPuerto + "-" + Model.CodigoProducto,
            centroorigen = Request.Params["centroorigen"],
            centrodistribucion = Request.Params["centrodistribucion"],
            cyo = Request.Params["cyo"]
        },
        new { id = "btnCancelar", @class = "btn btn-secondary" })
  </div>
</div>

<!-- Modal -->
@Html.Partial("_ModalMotivosPartial", Model.MotivosAnulacion, new ViewDataDictionary() { { "TipoAnulacion", true } })

@Scripts.Render("~/bundles/popper")
@section Scripts {
  @Scripts.Render("~/bundles/jqueryval")
  @Scripts.Render("~/bundles/Consignaciones")
  @Scripts.Render("~/bundles/motivoanulacion")
<script type="text/javascript">
        window.modelData = {
            actionGetMotivo: "@Url.Action("GetMotivo")",
            actionAnular: "@Url.Action("Anular")",
            // Endpoint complementario al Anular legacy: revierte la asociación
            // cupo ↔ solicitud en SOLTURNOS/SOLTURNOS_DETALLE para que la
            // solicitud vuelva a figurar como Pendiente en Pantalla 1. Se
            // invoca 1 vez por cada cupo anulado bajo tipo=Distribucion.
            actionAnularDistribucion: "@Url.Action("AnularDistribucion")",
            centro: "@Request.Params["centro"]",
            centrodistribucion: "@Request.Params["centrodistribucion"]",
            estadoBtnCancelar: false,
            estadoBtnAceptar: false,
            cyo: @((string.IsNullOrEmpty(Request.Params["cyo"]) || Request.Params["cyo"].ToLower() == "false") ? "false" : "true"),
            consignaciones: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Consignaciones)),
        }
</script>
  @Scripts.Render("~/bundles/Editar")
}
