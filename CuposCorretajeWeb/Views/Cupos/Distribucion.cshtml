@model CuposCorretajeWeb.Models.DistribuirCupoViewModel

@{
  ViewBag.Title = "Distribucion";
  //Html.EnableClientValidation();
}

@section Styles{
  @Styles.Render("~/Content/skeleton")
  @Styles.Render("~/Content/datepickercss")
  @Styles.Render("~/Content/autocompletecss")
  @Styles.Render("~/Content/datatables")
  @Styles.Render("~/Content/spinner")
  @Styles.Render("~/Content/WordTag")
  @Styles.Render("~/Content/solicitudes-matching")
}

<h2>Distribucion</h2>
@using (Html.BeginForm("Distribucion", "Cupos", new { centroorigen = Request.Params["centroorigen"], centrodistribucion = Request.Params["centrodistribucion"], cyo = Request.Params["cyo"] }, FormMethod.Post, new { id = "FormFiltro" }))
{
  @Html.AntiForgeryToken()
  <div class="row">
    <div class="col-md-2">
      <div class="form-group">
        @Html.LabelFor(model => model.Producto, htmlAttributes: new { @class = "control-label" })
        @Html.TextBoxFor(model => model.Producto, new { @class = "form-control", @readonly = "readonly" })
        @Html.ValidationMessageFor(model => model.Producto, "", new { @class = "text-danger" })
      </div>
    </div>
    <div class="col-md-5">
      <div class="form-group">
        @Html.LabelFor(model => model.Comprador, htmlAttributes: new { @class = "control-label" })
        @Html.TextBoxFor(model => model.Comprador, new { @class = "form-control", @readonly = "readonly" })
        @Html.ValidationMessageFor(model => model.Comprador, "", new { @class = "text-danger" })
      </div>
    </div>
    <div class="col-md-5">
      <div class="form-group">
        @Html.LabelFor(model => model.Puerto, htmlAttributes: new { @class = "control-label" })
        @Html.TextBoxFor(model => model.Puerto, new { @class = "form-control", @readonly = "readonly" })
        @Html.ValidationMessageFor(model => model.Puerto, "", new { @class = "text-danger" })
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-2">
      <div class="form-group">
        @Html.LabelFor(model => model.EntregaDesde, htmlAttributes: new { @class = "control-label" })
        @Html.TextBoxFor(model => model.EntregaDesde, "{0:dd/MM/yyyy}", new { @class = "form-control", autocomplete = "off" })
        @Html.ValidationMessageFor(model => model.EntregaDesde, "", new { @class = "text-danger" })
      </div>
    </div>
    <div class="col-md-2">
      <div class="form-group">
        @Html.LabelFor(model => model.EntregaHasta, htmlAttributes: new { @class = "control-label" })
        @Html.TextBoxFor(model => model.EntregaHasta, "{0:dd/MM/yyyy}", new { @class = "form-control", autocomplete = "off" })
        @Html.ValidationMessageFor(model => model.EntregaHasta, "", new { @class = "text-danger" })
      </div>
    </div>
    <div class="col-md-2">
      <div class="form-group">
        @Html.LabelFor(model => model.CosechaDesde, htmlAttributes: new { @class = "control-label" })
        @Html.TextBoxFor(model => model.CosechaDesde, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.CosechaDesde, "", new { @class = "text-danger" })
      </div>
    </div>
    <div class="col-md-2">
      <div class="form-group">
        @Html.LabelFor(model => model.CosechaHasta, htmlAttributes: new { @class = "control-label" })
        @Html.TextBoxFor(model => model.CosechaHasta, new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.CosechaHasta, "", new { @class = "text-danger" })
      </div>
    </div>
    <div class="col-md-4">
      <div class="form-group">
        @Html.LabelFor(model => model.CentroSeleccionado, "Centro", htmlAttributes: new { @class = "control-label" })
        @Html.DropDownListFor(model => model.CentroSeleccionado, Model.Centro, htmlAttributes: new { @class = "form-control" }@*, optionLabel: "--Seleccione--"*@)
        @Html.ValidationMessageFor(model => model.CentroSeleccionado, "", new { @class = "text-danger" })
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-md-12">
      <div class="form-group">
        <button type="submit" id="btnBuscar" class="btn btn-primary"><span id="btnBuscarTexto">Buscar</span></button>
      </div>
    </div>
  </div>
}
