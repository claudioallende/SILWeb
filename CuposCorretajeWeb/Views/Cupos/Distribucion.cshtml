<div class="row">
  <div class="col-md-12 text-right">
    <div class="form-group">
      <button id="btnAceptar" class="btn btn-primary">
        Aceptar
      </button>
      @Html.ActionLink("Cancelar", "Detalle",
          new
          {
              id = Model.CuentaComprador + "-" + Model.CuentaPuerto + "-" + Model.CodigoProducto,
              centroorigen = Request.Params["centroorigen"],
              centrodistribucion = Request.Params["centrodistribucion"],
              cyo = Request.Params["cyo"]
          },
          new { @class = "btn btn-danger" })
    </div>
  </div>
</div>

@Html.Partial("_InformaCuposPartial")

@section Scripts{
  @Scripts.Render("~/bundles/datepickerjs")
  @Scripts.Render("~/bundles/ValidaCuit")
  @Scripts.Render("~/bundles/autocompletejs")
  @Scripts.Render("~/bundles/skeleton")
  @Scripts.Render("~/bundles/datatables")
  @Scripts.Render("~/bundles/spinner")
  @Scripts.Render("~/bundles/WordTag")
<script>
        var spinnerBtnAceptar = new Spinner(document.getElementById("btnAceptar"));
        var spinnerBtnAceptarMotivo = new Spinner(document.getElementById("btnAceptarMotivo"));
        var btnInformaCupos = new Spinner(document.getElementById("btnInformaCupos"));
        var btnAceptarModalConsignaciones = document.getElementById("btnAceptarModalConsignaciones");
        var spinnerBtnAceptarConsignacion;
        if (btnAceptarModalConsignaciones != undefined) spinnerBtnAceptarConsignacion = new Spinner(document.getElementById("btnAceptarModalConsignaciones"));
        var spinnerBtnBuscar = new Spinner(document.getElementById("btnBuscar"));
        window.modelData = {
            modelId: "@Model.Id",
            actionDetalle: "@Url.Action("Detalle")",
            actionActualizarDistribucion: "@Url.Action("ActualizarDistribucion")",
            actionContratos: "@Url.Action("Contratos")",
            actionGetCuit: "@Url.Action("GetCuit")",
            actionCantidadCuposConsignacionSeleccionada: "@Url.Action("GetCantidadCuposConsignacionSeleccionada")",
            actionGetTablaContratos: "@Url.Action("GetTablaContratos")",
            //actionGetCuentaFromNombre: "@Url.Action("GetCuentaFromNombre", "Cuenta")",
            actionGetCuposCuitFromNroCuentaOrNombre: "@Url.Action("GetCuposCuitFromNroCuentaOrNombre", "Cuenta")",
            actionGetDetallePendienteAplicar: "@Url.Action("GetDetallePendienteAplicar", "Contrato")",
            actionGetContactoComercial: "@Url.Action("GetCuposCuitFromNroCuentaOrNombre", "Cuenta")",
            actionGetCuentas: "@Url.Action("GetCuentasByCuentas", "Cuenta")",
            cuentaComprador: "@Model.CuentaComprador",
            cuentaVendedor: "@Model.CuentaVendedor",
            cuentaPuerto: "@Model.CuentaPuerto",
            codigoProducto: "@Model.CodigoProducto",
            centrocontratos: "@Model.CentroSeleccionado",
            centroorigen: "@Request.Params["centroorigen"]",
            centrodistribucion: "@Request.Params["centrodistribucion"]",
            cantidaddias: 20,
            filtro: "@Html.Raw(Request.Url.Query)",
            //Definido en Distribucion.js
            cupo: {},
            observaciones: [],
            @{string cyo = Request.QueryString["cyo"] != null ? "&cyo=true" : "";}
            cyo: "@cyo",
            cuentas: [],
            consignaciones: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Consignaciones)),
        }
</script>
  @Scripts.Render("~/bundles/Consignaciones")
  @Scripts.Render("~/bundles/Distribucion")
  @Scripts.Render("~/bundles/motivoanulacion")
  <script type="text/javascript">
    var controlEstados;
    var datatable;
    var tabulacion;
    $(document).ready(function () {
      datatable = ConvertirDataTable();
      tabulacion = new DataTablesTabulacion(document.getElementsByClassName("DTFC_LeftWrapper")[0], document.getElementsByClassName("DTFC_RightWrapper")[0], document.getElementsByClassName("dataTables_scrollBody")[0]);
      showDataTable(); //skeleton.js

      controlEstados = new EstadoGrilla(datatable);

      //Ver en MotivoAnulacion.js
      handleClickBtnShowModal(document.getElementById("btnAceptar"), function () {
        var hayDecremento = false;
        //Obtiene la matriz de modificaciones realizadas, si existe algun decremento se muestra el modal Motivos
        hayDecremento = controlEstados.modificacionesDelEstadoInicial.matrizDiferencias.some(function (array) {
          return array.some(function (el) {
            return el < 0;
          });
        });
        if (!hayDecremento) distribuir(spinnerBtnAceptar);
        return hayDecremento;
      });

      //Evento del boton Aceptar del modal Motivo
      handleClickBtnAceptarMotivo(function (textMotivo) {
        if (control_destinatario()) distribuir(spinnerBtnAceptarMotivo, textMotivo);
      });
    });

    function control_destinatario() {
      valida = true;
      CuitDestinatario = document.getElementById("Cuitdestinatario");
      NombreDestinatario = document.getElementById("CuitdestinatarioName");
      if (CuitDestinatario.value.trim() == "") {
        valida = false;
        document.querySelector('span[data-valida-campo="CuitDestinatario"]').innerHTML = CuitDestinatario.dataset["valida"];
      } else {
        document.querySelector('span[data-valida-campo="CuitDestinatario"]').innerHTML = "";
      }

      if (NombreDestinatario.value.trim() == "") {
        valida = false;
        document.querySelector('span[data-valida-campo="NombreDestinatario"]').innerHTML = NombreDestinatario.dataset["valida"];
      } else {
        document.querySelector('span[data-valida-campo="NombreDestinatario"]').innerHTML = "";
      }
      return valida;
    }

    function ConvertirDataTable() {
      var table = $('#TablaDistribuciones').removeAttr('width').DataTable({
        scrollY: "400px",
        scrollX: true,
        scrollCollapse: true,
        paging: false,
        bFilter: false,
        bInfo: false,
        bSort: false,
        fixedColumns: {
          leftColumns: 7,
          rightColumns: 1
        }
      });
      return table;
    }
  </script>
}
