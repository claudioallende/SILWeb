@* Modal de matching en distribución de cupos (Pantalla 3):
   Variante A (cupo con vendedor) + Variante B (sin vendedor) + diálogos operativos.
   El contenido se hidrata por JS (Scripts/MatchingDistribucion.js) a partir
   del flujo AJAX de Buscar. *@
@{
  Html.RenderPartial("_MatchingDistribucionPartial");
}

@section Scripts{
  @Scripts.Render("~/bundles/datepickerjs")
  @Scripts.Render("~/bundles/ValidaCuit")
  @Scripts.Render("~/bundles/autocompletejs")
  @Scripts.Render("~/bundles/skeleton")
  @Scripts.Render("~/bundles/datatables")
  @Scripts.Render("~/bundles/spinner")
  @Scripts.Render("~/bundles/WordTag")
  <script>
        var spinnerBtnAceptar = new Spinner(document.getElementById("btnAceptar"));
        var spinnerBtnAceptarMotivo = new Spinner(document.getElementById("btnAceptarMotivo"));
        var btnInformaCupos = new Spinner(document.getElementById("btnInformaCupos"));
        var btnAceptarModalConsignaciones = document.getElementById("btnAceptarModalConsignaciones");
        var spinnerBtnAceptarConsignacion;
        if (btnAceptarModalConsignaciones != undefined) spinnerBtnAceptarConsignacion = new Spinner(document.getElementById("btnAceptarModalConsignaciones"));
        var spinnerBtnBuscar = new Spinner(document.getElementById("btnBuscar"));
        window.modelData = {
            modelId: "@Model.Id",
            actionDetalle: "@Url.Action("Detalle")",
            actionActualizarDistribucion: "@Url.Action("ActualizarDistribucion")",
            actionBuscarCuposConMatch: "@Url.Action("BuscarCuposConMatch", "CuposMatching")",
