    <div class="form-group">
      <label for="Vendedor">Vendedor</label>
      <div class="input-group mb-3">
        <div class="input-group-prepend">
          <span class="input-group-text" id=""><span class="oi oi-magnifying-glass"></span></span>
        </div>
        <input id="Vendedor" type="text" class="form-control" name="Vendedor" />
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-12">
    <div class="form-group">
      <div id="accordionTwo">
        <div class="card">
          <div class="card-header" id="headingTwo">
            <h5 class="mb-0">
              <button class="btn btn-link" data-toggle="collapse" data-target="#collapseTwo" aria-expanded="true" aria-controls="collapseTwo">
                Ver cupos informados y cupos distribuidos no informados
              </button>
            </h5>
          </div>

          <div id="collapseTwo" class="collapse" aria-labelledby="headingOne" data-parent="#accordionTwo">
            <div class="card-body">
              <div class="form-group overflow-auto">
                @if (Model.CuposAgrupados != null)
                {
                  @Html.Partial("_DetalleCuposAgrupadosPorInformados", Model.CuposAgrupados)
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-12">
    <div class="btn-group-toggle" data-toggle="buttons" title="Filtra cupos asignados que superan el máximo disponible para los contratos">
      <label class="btn btn-outline-primary btn-with-icon">
        <input type="checkbox" autocomplete="off" onchange="handleChangeFiltroCantidadCupoSuperaDisponible(this)">
        Ver asignaciones excedidas
      </label>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-12">
    <div class="form-group container_table_distribucion">
      @Html.Partial("~/Views/Contratos/_DistribucionContratosPartial.cshtml", Model.DistribucionesDisponibles)
    </div>
  </div>
</div>

<!-- Modal Contratos -->
<div class="modal fade" id="idModalContratos" tabindex="-1" role="dialog" aria-labelledby="idModalContratosTitulo" aria-hidden="true">
  <div class="modal-dialog modal-xl" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="idModalContratosTitulo">Contratos</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <table id="TablaContratos" class="table table-sm table-striped table-wrap-bordered">
          <thead>
            <tr>
              <th>Contrato</th>
              <th>Neg.</th>
              <th>Oper.</th>
              <th>Prod.</th>
              <th>Cos.</th>
              <th>Entrega</th>
              <th>Vto.Ent.</th>
              <th>Pactadas</th>
              <th>Apli.</th>
              <th>Pend.Ent.</th>
              <th>Liq.</th>
              <th>Precio</th>
              <th>Destino</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<!--Modal motivos-->
@Html.Partial("_ModalMotivosPartial", Model.MotivosDecrementoCupos)

