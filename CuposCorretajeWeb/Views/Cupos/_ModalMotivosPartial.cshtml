@model IEnumerable<CuposCorretajeWeb.Models.DTabla>

@{
    bool TipoAnulacion = this.ViewData.ContainsKey("TipoAnulacion") ? (bool)this.ViewData["TipoAnulacion"] : false;
}

<div class="modal fade" id="modalMotivo" tabindex="-1" role="dialog" aria-labelledby="modalMotivoLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalMotivoLabel">Motivo</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                @if (TipoAnulacion) { 
                    <div id="TipoAnulacion" class="form-group">
                        <label id="lblTipoAnulacionSeleccionado" for="TipoAnulacionSeleccionado">Tipo de anulación</label>
                        <select id="TipoAnulacionSeleccionado" name="TipoAnulacionSeleccionado" class="form-control form-control-sm">
                            <option value="">--Seleccione--</option>
                            <option value="Distribucion">Anular Distribución</option>
                            <option value="Cupo">Anular Turno</option>
                        </select>
                    </div>
                }
                <div class="form-group">
                    @if (TipoAnulacion)
                    {
                        <label for="MotivoAnulacionSeleccionado">Motivo de anulación</label>
                    }
                    <select id="MotivoAnulacionSeleccionado" name="MotivoAnulacionSeleccionado" class="form-control form-control-sm">
                        <option value="">--Seleccione--</option>
                        @foreach (var motivo in Model)
                        {
                            <option value="@motivo.Clave">@motivo.Valor</option>
                        }
                    </select>
                </div>
                <textarea class="form-control" name="descripcionMotivo" id="descripcionMotivo" disabled rows="3"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="btnAceptarMotivo">Aceptar</button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>