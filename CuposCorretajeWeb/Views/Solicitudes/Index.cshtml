        { data: "NombreDestino" },
        {
          data: function (row, type, set, meta) {
            return row.CantidadFechas.find(function (el) { return el.DiaSemana == (meta.col - cantidadColumnasAntesFechas) })?.Cantidad ?? 0;
          }
        },
        {
          data: function (row, type, set, meta) {
            return row.CantidadFechas.find(function (el) { return el.DiaSemana == (meta.col - cantidadColumnasAntesFechas) })?.Cantidad ?? 0;
          }
