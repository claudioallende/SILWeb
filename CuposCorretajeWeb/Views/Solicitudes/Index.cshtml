  </tbody>
  <tfoot>
    <tr>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      @for (int Dia = 0; Dia < Model.CantidadDias; Dia++)
      {
        <td></td>
      }
      <td class="border-left text-center"></td>
    </tr>
  </tfoot>
</table>
@section Scripts{
  @Scripts.Render("~/bundles/datatablesv2")
  <script type="text/javascript">
    var granoGroupColumn = 0;
    const cantidadColumnasAntesFechas = 4

    function drawCallbackTablaSolicitudes(settings) {
      var api = this.api();
      var rows = api.rows({ page: 'current' }).nodes();
      var lastGranoGroup = null;
      var lastSolicitanteGroup = null;

      var solicitanteGroupColumn = 0;
      var groups = []

      api.column(granoGroupColumn, { page: 'current' })
        .data()
        .each(function (granoGroup, i) {
          var dataRow = Array.from(rows[i].cells).map(function (cell) { return cell.innerText });

          if (lastGranoGroup !== granoGroup) {
            groups.push({
              grano: granoGroup,
              solicitantes: [{
                nombre: dataRow[solicitanteGroupColumn],
                filas: [dataRow],
                indice: i
              }]
            })
            $(rows)
              .eq(i)
              .before(
                '<tr class="group" style="background-color:#1c1f5e;color:white"><td colspan="11">' +
                granoGroup +
                '</td></tr>'
              );

            lastGranoGroup = granoGroup;
            lastSolicitanteGroup = dataRow[solicitanteGroupColumn]
          } else {
            var group = groups.find(function (group) { return group.grano === granoGroup })
            var solicitante = group.solicitantes.find(function (sol) { return sol.nombre == dataRow[solicitanteGroupColumn] })
            if (solicitante) {
              solicitante.filas.push(dataRow)
            } else {
              group.solicitantes.push({ nombre: dataRow[solicitanteGroupColumn], filas: [dataRow], indice: i })
            }
          }
          rows[i].cells[solicitanteGroupColumn].innerText = ""
        });

      lastSolicitanteGroup = null
      groups.forEach(function (group, i) {
        group.solicitantes.forEach(function (solicitante) {
          if (lastSolicitanteGroup !== solicitante.nombre) {
            $(rows)
              .eq(solicitante.indice)
              .before(
                '<tr class="group" style="background-color:black;color:white"><td colspan="3">' +
                solicitante.nombre +
                '</td>' + '<td style="text-align:right">' + solicitante.filas.map(function (fila) { return Number(fila[3]) }).reduce(function (accum, a) { return accum + a }) + '</td>'
                + '<td style="text-align:right">' + solicitante.filas.map(function (fila) { return Number(fila[4]) }).reduce(function (accum, a) { return accum + a }) + '</td>'
                + '<td style="text-align:right">' + solicitante.filas.map(function (fila) { return Number(fila[5]) }).reduce(function (accum, a) { return accum + a }) + '</td>'
                + '<td style="text-align:right">' + solicitante.filas.map(function (fila) { return Number(fila[6]) }).reduce(function (accum, a) { return accum + a }) + '</td>'
                + '<td style="text-align:right">' + solicitante.filas.map(function (fila) { return Number(fila[7]) }).reduce(function (accum, a) { return accum + a }) + '</td>'
                + '<td style="text-align:right">' + solicitante.filas.map(function (fila) { return Number(fila[8]) }).reduce(function (accum, a) { return accum + a }) + '</td>'
                + '<td style="text-align:right">' + solicitante.filas.map(function (fila) { return Number(fila[9]) }).reduce(function (accum, a) { return accum + a }) + '</td><td></td>'
                + '</tr>'
            );

            lastSolicitanteGroup = solicitante.nombre
          }
        })
        lastSolicitanteGroup = null
      })
    }

    let dataTable = new DataTable('#tablaSolicitudes', {
