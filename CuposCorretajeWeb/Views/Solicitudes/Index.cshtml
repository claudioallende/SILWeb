@model CuposCorretajeWeb.Models.Solicitudes.IndexModel
@{
    ViewBag.Title = "Solicitudes de Turno";
    var fechasHeader = new List<string>();
    for (int i = 0; i < Model.CantidadDias; i++)
    {
        fechasHeader.Add(Model.FechaReferencia.AddDays(i).ToString("dd/MM"));
    }
}

@section Styles{
    <link rel="stylesheet" href="~/Content/solicitudes-index.css" />
}

<div class="container-fluid">

    <!-- ===== Page header ===== -->
    <div class="sil-page-hd">
        <div>
            <h1>Solicitudes de Turno</h1>
            <p>@(string.IsNullOrEmpty(Model.Subtitulo)
                ? $"Solicitudes pendientes de asignación — Centro {Model.Centro} · {Model.FechaReferencia:dd/MM/yyyy}"
                : Model.Subtitulo)</p>
        </div>
    </div>

    <!-- ===== Toolbar ===== -->
    <div class="sil-toolbar">
        <button type="button" class="sil-btn" id="btnFiltro">
            <i class="fa-solid fa-magnifying-glass"></i>&nbsp; Filtro
        </button>
    </div>

    <!-- ===== Leyenda ===== -->
    <div class="sil-legend">
        <span><span class="sil-dot" style="background:#e74c3c;"></span>Cupos disponibles sin asignar</span>
        <span><span class="sil-dot" style="background:#27ae60;"></span>Sin pendientes</span>
        <span class="sil-badge sil-badge-dir">Match directo</span>
        <span class="sil-badge sil-badge-par">Match parcial</span>
        <span class="sil-badge sil-badge-obs">Con observaciones</span>
        <span class="sil-badge sil-badge-pending">Pendiente</span>
        <span class="sil-badge sil-badge-asig">Asignada</span>
        <span class="sil-badge sil-badge-rech">Rechazada</span>
    </div>

    <!-- ===== Tabla CONTRACTUAL ===== -->
    <div class="sil-section-title">
        Solicitudes CONTRACTUAL
        <span class="sil-section-subtitle" id="lblContractualCount">—</span>
    </div>
    <div class="sil-tbl-wrap">
        <div class="sil-tbl-scroller">
            <table id="tablaSolicitudes" class="sil-tbl">
                <thead id="theadContractual">
                    <!-- Se completa con JS al cargar la respuesta del endpoint -->
                </thead>
                <tbody id="tbodyContractual">
                    <tr><td colspan="@(6 + Model.CantidadDias * 2 + 1)"><div class="sil-empty"><div class="sil-empty-icon">…</div>Cargando solicitudes…</div></td></tr>
                </tbody>
                <tfoot id="tfootContractual"></tfoot>
            </table>
        </div>
        <div class="sil-pager" id="pagerContractual"></div>
    </div>

    <!-- ===== Tabla FUTURO ===== -->
    <div class="sil-section-title">
        Solicitudes FUTURO
        <span class="sil-section-subtitle" id="lblFuturoCount">—</span>
    </div>
    <div class="sil-tbl-wrap">
        <div class="sil-tbl-scroller">
            <table id="tablaSolicitudesFuturo" class="sil-tbl">
                <thead id="theadFuturo"></thead>
                <tbody id="tbodyFuturo">
                    <tr><td colspan="@(6 + Model.CantidadDias * 2 + 1)"><div class="sil-empty"><div class="sil-empty-icon">…</div>Cargando solicitudes…</div></td></tr>
                </tbody>
                <tfoot id="tfootFuturo"></tfoot>
            </table>
        </div>
        <div class="sil-pager" id="pagerFuturo"></div>
    </div>

    <!-- ===== Anotación / ayuda contextual ===== -->
    <div class="sil-annotation">
        <strong>Pantalla 1 — Grilla de solicitudes de turno.</strong>
        El operador visualiza todas las solicitudes pendientes de los centros que tiene asignados.
        La columna <em>Cupos compatibles</em> muestra el resultado del motor de matching en tiempo real.
        Los días marcados en rojo indican cupos disponibles aún sin asignar a solicitudes pendientes.
        Al hacer clic en <em>ver</em> se navega al detalle de la solicitud.
    </div>

</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            ShowLoader();

            // Loader global
            $(document).ajaxStart(function () { ShowLoader(); });
            $(document).ajaxStop(function () { HideLoader(); });
            $(document).ajaxError(function () { HideLoader(); });

            // ----- Constantes de render -----
            const COL_GRANO = 0;
            const COL_SOLICITANTE = 1;
            const COL_COMPRADOR = 2;
            const COL_ZONA = 3;
            const COL_ESTADO = 4;
            const COL_CUPOS = 5;
            // COL 6 .. 6 + 2*N - 1 : fechas (TR/TO)
            const COL_ACCION = 6 + @(Model.CantidadDias) * 2;

            // ----- Handlers de la toolbar -----
            $('#btnFiltro').on('click', function () {
                Swal.fire({
                    icon: 'info',
                    title: 'Filtro',
                    text: 'Pantalla de filtros — próximamente.',
                    confirmButtonColor: '#1a3a6b'
                });
            });

            // ----- Carga inicial -----
            $.ajax({
                url: "/Solicitudes/GetAllPendingShiftRequests",
                method: "GET",
                dataType: "json",
                success: function (response) {
                    renderTabla({
                        theadId: '#theadContractual',
                        tbodyId: '#tbodyContractual',
                        tfootId: '#tfootContractual',
                        countLabelId: '#lblContractualCount',
                        pagerId: '#pagerContractual',
                        rows: response.Contractuales || [],
                        fechasHeader: response.FechasHeader || [],
                        pageSize: 10,
                        currentPage: 1
                    });
                    renderTabla({
                        theadId: '#theadFuturo',
                        tbodyId: '#tbodyFuturo',
                        tfootId: '#tfootFuturo',
                        countLabelId: '#lblFuturoCount',
                        pagerId: '#pagerFuturo',
                        rows: response.Futuros || [],
                        fechasHeader: response.FechasHeader || [],
                        pageSize: 10,
                        currentPage: 1
                    });
                },
                error: function (xhr, status, error) {
                    console.error("Error al obtener los datos:", error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'No se pudieron cargar las solicitudes pendientes.',
                        confirmButtonColor: '#1a3a6b'
                    });
                    ['#tbodyContractual', '#tbodyFuturo'].forEach(function (id) {
                        $(id).html('<tr><td colspan="' + (@(Model.CantidadDias) * 2 + 7) + '"><div class="sil-empty"><div class="sil-empty-icon">⚠</div>Error al cargar los datos.</div></td></tr>');
                    });
                },
                complete: function () { HideLoader(); }
            });

            // ----- Función reutilizable de render de tabla -----
            function renderTabla(opts) {
                const { theadId, tbodyId, tfootId, countLabelId, pagerId, rows, fechasHeader, pageSize, currentPage } = opts;

                const colspanTotal = 6 + fechasHeader.length * 2 + 1;
                const totalRows = rows.length;
                const totalPages = Math.max(1, Math.ceil(totalRows / pageSize));
                const page = Math.min(Math.max(1, currentPage || 1), totalPages);

                // Header: 2 filas (siempre el mismo)
                let headHtml = '<tr>' +
                    '<th class="tl" rowspan="2">Grano</th>' +
                    '<th class="tl" rowspan="2">Solicitante</th>' +
                    '<th class="tl" rowspan="2">Comprador</th>' +
                    '<th rowspan="2">Zona</th>' +
                    '<th rowspan="2">Estado</th>' +
                    '<th rowspan="2">Cupos compatibles</th>';
                fechasHeader.forEach(function (f) {
                    headHtml += '<th colspan="2">' + f + '</th>';
                });
                headHtml += '<th rowspan="2"></th></tr>';

                headHtml += '<tr>';
                fechasHeader.forEach(function () {
                    headHtml += '<th>TR</th><th>TO</th>';
                });
                headHtml += '</tr>';
                $(theadId).html(headHtml);

                // Contador global
                $(countLabelId).text(totalRows + ' fila' + (totalRows !== 1 ? 's' : ''));

                // Body
                if (!totalRows) {
                    $(tbodyId).html('<tr><td colspan="' + colspanTotal + '"><div class="sil-empty"><div class="sil-empty-icon">∅</div>No hay solicitudes para mostrar.</div></td></tr>');
                    $(tfootId).html('');
                    renderPager(pagerId, 0, 0, pageSize, function () { });
                    return;
                }

                // Calcular totales por fecha sobre el set COMPLETO (no la página actual)
                const totales = fechasHeader.map(function () { return { tr: 0, to: 0, tieneCupoDisponible: false }; });
                rows.forEach(function (r) {
                    (r.CantidadFechas || []).forEach(function (d, idx) {
                        if (idx < totales.length) {
                            totales[idx].tr += d.Cantidad || 0;
                            totales[idx].to += d.CantidadFuturo || 0;
                            if (d.TieneCupoDisponible) totales[idx].tieneCupoDisponible = true;
                        }
                    });
                });

                // Slice de la página actual
                const startIdx = (page - 1) * pageSize;
                const pageRows = rows.slice(startIdx, startIdx + pageSize);

                let bodyHtml = '';
                let lastGrano = null;
                pageRows.forEach(function (r) {
                    // Separador visual por cambio de Grano
                    if (lastGrano !== null && lastGrano !== r.NombreGrano) {
                        bodyHtml += '<tr class="sil-row-grupo"><td colspan="' + colspanTotal + '"></td></tr>';
                    }
                    lastGrano = r.NombreGrano;

                    bodyHtml += '<tr data-id="' + (r.Id || 0) + '">' +
                        renderCeldaTexto(r.NombreGrano || '—', 'tl') +
                        renderCeldaTexto(r.NombreVendedor || '—', 'tl') +
                        renderCeldaTexto(r.NombreComprador || '—', 'tl') +
                        renderCeldaTexto(r.CodigoCentro || '—', '') +
                        renderCeldaEstado(r.EstadoBadge, r.EstadoLabel) +
                        renderCeldaCupos(r.CuposCompatibles);

                    // Celdas TR/TO por fecha
                    (r.CantidadFechas || []).forEach(function (d) {
                        bodyHtml += renderCeldaFecha(d);
                    });

                    // Acción
                    bodyHtml += '<td><button type="button" class="sil-icon-btn btn-ver" data-id="' + (r.Id || 0) + '" title="Ver detalle">&#9776; ver</button></td>';
                    bodyHtml += '</tr>';
                });
                $(tbodyId).html(bodyHtml);

                // Footer con totales del set completo
                let footHtml = '<tr class="sil-tr-total">' +
                    '<td colspan="6" class="tl">Total Diario</td>';
                totales.forEach(function (t) {
                    const mostrarTrRojo = t.tr === 0 && t.tieneCupoDisponible;
                    footHtml += '<td>' + (t.tr > 0 ? t.tr : (mostrarTrRojo ? '<span class="sil-cell-red">0</span>' : '<span class="sil-zero">0</span>')) + '</td>';
                    // TO queda en 0 simple hasta que se complete la explicación correspondiente.
                    footHtml += '<td><span class="sil-zero">0</span></td>';
                });
                footHtml += '<td></td></tr>';
                $(tfootId).html(footHtml);

                // Paginador
                renderPager(pagerId, totalRows, page, pageSize, function (newPage) {
                    renderTabla(Object.assign({}, opts, { currentPage: newPage }));
                });

                // Click en "ver" → placeholder (próximamente Pantalla 2)
                $(tbodyId).off('click', '.btn-ver').on('click', '.btn-ver', function () {
                    const id = $(this).data('id');
                    Swal.fire({
                        icon: 'info',
                        title: 'Detalle de solicitud',
                        text: 'Próximamente: Pantalla 2 (Detalle con selección de días). Id=' + id,
                        confirmButtonColor: '#1a3a6b'
                    });
                });
            }

            // ----- Paginador -----
            function renderPager(pagerId, totalRows, currentPage, pageSize, onPageChange) {
                const totalPages = Math.max(1, Math.ceil(totalRows / pageSize));
                const page = Math.min(Math.max(1, currentPage || 1), totalPages);
                const $p = $(pagerId);
                if (!$p.length) return;

                if (totalRows === 0) {
                    $p.html('<span class="sil-pager-info">Sin resultados</span>');
                    return;
                }

                const desde = (page - 1) * pageSize + 1;
                const hasta = Math.min(page * pageSize, totalRows);

                let html = '<span class="sil-pager-info">Mostrando ' + desde + '–' + hasta + ' de ' + totalRows + '</span>';

                html += '<button type="button" data-pg="prev"' + (page === 1 ? ' disabled' : '') + '>&lsaquo;</button>';

                // Rango de páginas a mostrar: si hay muchas, ventana de 5 alrededor de la actual.
                const windowSize = 5;
                let start = Math.max(1, page - Math.floor(windowSize / 2));
                let end = Math.min(totalPages, start + windowSize - 1);
                start = Math.max(1, end - windowSize + 1);

                for (let i = start; i <= end; i++) {
                    html += '<button type="button" data-pg="' + i + '"' + (i === page ? ' class="sil-pager-active"' : '') + '>' + i + '</button>';
                }

                html += '<button type="button" data-pg="next"' + (page === totalPages ? ' disabled' : '') + '>&rsaquo;</button>';

                $p.html(html);
                $p.off('click', 'button').on('click', 'button', function () {
                    if ($(this).is(':disabled')) return;
                    const v = $(this).data('pg');
                    let np = page;
                    if (v === 'prev') np = page - 1;
                    else if (v === 'next') np = page + 1;
                    else np = parseInt(v, 10);
                    if (np !== page) onPageChange(np);
                });
            }

            // ----- Helpers de celda -----
            function renderCeldaTexto(valor, alignClass) {
                return '<td' + (alignClass ? ' class="' + alignClass + '"' : '') + '>' + escapeHtml(valor) + '</td>';
            }

            function renderCeldaFecha(d) {
                // TR: el controller deposita aquí Cantidad (CONTRACTUAL) o CantidadFuturo
                // (FUTURO) según la tabla a la que pertenece la fila. El render es
                // genérico: si hay valor se muestra, si no y hay cupo disponible
                // se pinta el chip rojo, si no, el 0 gris.
                let trCell = '<td>';
                if (d.Cantidad > 0) trCell += d.Cantidad;
                else if (d.TieneCupoDisponible) trCell += '<span class="sil-cell-red">0</span>';
                else trCell += '<span class="sil-zero">0</span>';
                trCell += '</td>';

                // TO: queda en 0 simple hasta que se complete la explicación
                // correspondiente. Mismo criterio de color que TR.
                let toCell = '<td>';
                if (d.TieneCupoDisponible) toCell += '<span class="sil-cell-red">0</span>';
                else toCell += '<span class="sil-zero">0</span>';
                toCell += '</td>';

                return trCell + toCell;
            }

            function renderCeldaEstado(cls, label) {
                return '<td><span class="sil-badge sil-badge-' + cls + '">' + escapeHtml(label || 'Pendiente') + '</span></td>';
            }

            function renderCeldaCupos(cc) {
                if (!cc) return '<td><span class="sil-zero">—</span></td>';

                if (cc.CupoAsignadoId) {
                    return '<td><span style="font-size:11px;color:#155724;font-weight:500;">Cupo #' + cc.CupoAsignadoId + ' asignado</span></td>';
                }

                if (cc.TextoResumen === 'Rechazo manual') {
                    return '<td><span style="font-size:11px;color:#a93226;">Rechazo manual</span></td>';
                }

                if (cc.TextoResumen === 'Sin coincidencia') {
                    return '<td><span style="font-size:11px;color:#9aa3b5;">Sin coincidencia</span></td>';
                }

                // Para casos con directos/parciales/observaciones
                let html = '';
                if (cc.Directos > 0) html += '<span class="sil-badge sil-badge-dir" style="margin-right:3px;">' + cc.Directos + ' directo' + (cc.Directos !== 1 ? 's' : '') + '</span>';
                if (cc.Parciales > 0) html += '<span class="sil-badge sil-badge-par" style="margin-right:3px;">' + cc.Parciales + ' parcial' + (cc.Parciales !== 1 ? 'es' : '') + '</span>';
                if (cc.Observaciones > 0) html += '<span class="sil-badge sil-badge-obs">' + cc.Observaciones + ' obs.</span>';

                if (!html) html = '<span style="font-size:11px;color:#9aa3b5;">' + escapeHtml(cc.TextoResumen || '—') + '</span>';
                return '<td>' + html + '</td>';
            }

            function escapeHtml(s) {
                if (s === null || s === undefined) return '';
                return String(s)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }
        });
    </script>
}
