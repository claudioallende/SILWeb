            return row.CantidadFechas.find(function (el) { return el.DiaSemana == (meta.col - cantidadColumnasAntesFechas) })?.Cantidad ?? 0;
          }
        },
        {
          data: function (row, type, set, meta) {
            return row.CantidadFechas.find(function (el) { return el.DiaSemana == (meta.col - cantidadColumnasAntesFechas) })?.Cantidad ?? 0;
          }
        },
        {
          data: function (row, type, set, meta) {
            return row.CantidadFechas.find(function (el) { return el.DiaSemana == (meta.col - cantidadColumnasAntesFechas) })?.Cantidad ?? 0;
          }
        },
        {
          data: function (row, type, set, meta) {
            return row.CantidadFechas.find(function (el) { return el.DiaSemana == (meta.col - cantidadColumnasAntesFechas) })?.Cantidad ?? 0;
          }
        },
        {
          data: function (row, type, set, meta) {
            return "";
          }
        },
      ],
      drawCallback: drawCallbackTablaSolicitudes,
      language: {
        "search": "Buscar",
        "loadingRecords": "Cargando...",
        "zeroRecords": "No se encontraron datos",
        "info": "Mostrando _START_ hasta _END_ de _TOTAL_ filas",
        "infoEmpty": "Mostrando 0 hasta 0 de 0 filas",
