@model CuposCorretajeWeb.Models.Solicitudes.IndexModel
@{
  ViewBag.Title = "Solicitudes";
}
@section Styles{
  @Styles.Render("~/Content/datatablesv2")
}

<table id="tablaSolicitudes" class="table table-sm table-striped table-wrap-bordered" style="font-size: 0.9rem;margin-bottom:7px;width:100%;white-space:nowrap;">
  <thead>
    <tr>
      <th>Grano</th>
      <th>Vendedor</th>
      <th>Comprador</th>
      <th>Destino</th>
      @for (int Dia = 0; Dia < Model.CantidadDias; Dia++)
      {
        <th colspan="1" class="border-left">@DateTime.Now.AddDays(Dia).Date.ToString("dd/MM")</th>
      }
      <th class="border-left"></th>
    </tr>
  </thead>
  <tbody>
  </tbody>
  <tfoot>
    <tr>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      @for (int Dia = 0; Dia < Model.CantidadDias; Dia++)
      {
        <td></td>
      }
      <td class="border-left text-center"></td>
    </tr>
  </tfoot>
</table>

