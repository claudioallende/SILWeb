@using CuposCorretajeWeb.Models.Solicitudes
@using Newtonsoft.Json;
@model SolicitudViewModel
@{
    ViewBag.Title = "Detalle de Solicitud";

    var esEditable = Model != null && Model.EsEditable;
    var readClass = esEditable ? "" : "sil-readonly";
    var estadoBadge = (ViewBag.EstadoBadge as string) ?? "pending";
    var estadoLabel = (ViewBag.EstadoLabel as string) ?? "Pendiente";
    var modoTexto = esEditable ? "Modo edición" : "Modo sólo lectura";
    var errorMessage = ViewBag.ErrorMessage as string;
    var observacion = Model?.Observacion;

    // Para los 7 días hardcodeados, los valores TR/TO no vienen en el VM legacy
    // (sólo viene `Fechas` con TR). TO no se persiste en el VM por ahora, queda en 0.
    // Cuando se enchufe el motor de matching, se reemplaza por un listado real.
}

@section Styles {
    <link rel="stylesheet" href="~/Content/solicitudes-alta.css" />
}

<div class="container-fluid">
    <div class="sil-page-hd">
        <div>
            <h1>Detalle de Solicitud</h1>
            <p class="text-muted">Selección de días y cupos compatibles</p>
        </div>
    </div>

    <div class="@readClass">
        <!-- Banner de modo + estado + (opcional) error -->
        <div class="sil-mode-banner @(string.IsNullOrEmpty(errorMessage) ? "" : "sil-mode-banner-error")">
            <span class="sil-badge sil-badge-@estadoBadge">@estadoLabel</span>
            <span class="sil-mode-banner-text">@modoTexto</span>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <span class="sil-mode-banner-text">— @errorMessage</span>
            }
        </div>

        <!-- Botón "Volver a grilla" -->
        <a href="@Url.Action("Index", "Solicitudes")" class="sil-btn sil-btn-keep">← Volver a grilla</a>

        <!-- Cabecera resumen -->
        <div class="sil-summary">
            <div class="sil-summary-cell">
                <small>Solicitante</small>
                <div>@(Model?.Solicitante ?? "—")</div>
            </div>
            <div class="sil-summary-cell">
                <small>Grano</small>
                <div>@(Model?.NombreGrano ?? "—")</div>
            </div>
            <div class="sil-summary-cell">
                <small>Comprador</small>
                <div>@(Model?.Comprador ?? "—")</div>
            </div>
            <div class="sil-summary-cell">
                <small>Puerto</small>
                <div>@(Model?.NombreDestino ?? "—")</div>
            </div>
            <div class="sil-summary-cell">
                <small>Zona</small>
                <div>@(Model?.CodigoCentro ?? "—")</div>
            </div>
        </div>

        <!-- Banner de Observaciones (ámbar, sólo si hay contenido) -->
        @if (!string.IsNullOrWhiteSpace(observacion))
        {
            <div class="sil-annotation" style="border-left-color: var(--sil-amber-border); background: var(--sil-amber-light); color: var(--sil-amber);">
                <strong>Observaciones del solicitante</strong>
                <div>@observacion</div>
            </div>
        }

        <!-- Layout 2 paneles -->
        <div class="row" style="margin-top: 8px;">
            <!-- Panel izquierdo -->
            <div class="col-7">
                <div class="sil-section-title">
                    Solicitudes por día — 7 días
                    <span class="sil-section-subtitle" id="lblCantidadSeleccion">0 día(s) seleccionado(s)</span>
                </div>
                <div class="sil-tbl-wrap">
                    <table class="sil-tbl" id="tablaDias">
                        <thead>
                            <tr>
                                <th style="width:36px;"></th>
                                <th>Fecha</th>
                                <th style="width:90px;">Sol. TR</th>
                                <th style="width:90px;">Sol. TO</th>
                                <th style="width:130px;">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int dia = 0; dia < 7; dia++)
                            {
                                var fecha = DateTime.Now.AddDays(dia).Date;
                                var fechaKey = fecha.ToString("yyyy-MM-dd");
                                var fechaDisplay = fecha.ToString("dd/MM");
                                var diaSemana = fecha.ToString("ddd");
                                var dict = (Model != null) ? Model.Fechas : null;
                                var tr = (dict != null && dict.ContainsKey(fechaKey)) ? dict[fechaKey] : 0;
                                // TO no se persiste en el VM legacy: queda en 0 por ahora.
                                var toFuturas = 0;
                                <tr data-fecha="@fechaKey">
                                    <td style="text-align:center;">
                                        <input type="checkbox" class="chkDia" @(esEditable ? "" : "disabled=\"disabled\"") />
                                    </td>
                                    <td>
                                        <strong>@fechaDisplay</strong>
                                        <small class="text-muted">@diaSemana</small>
                                    </td>
                                    <td style="text-align:center;">@tr</td>
                                    <td style="text-align:center;">@toFuturas</td>
                                    <td style="text-align:center;">
                                        <span class="sil-badge sil-badge-empty" data-estado="vacio">Sin solicitudes</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="text-muted" id="lblDiasSeleccionados" style="margin-top: 8px; font-size: 11.5px;">
                    0 día(s) seleccionado(s) · Total: 0 TR
                </p>

                <!-- Acciones debajo de la tabla -->
                <div class="sil-actions-block">
                    <button type="button" class="sil-btn sil-btn-danger sil-btn-block" id="btnRechazarCompleta" @(esEditable ? "" : "disabled=\"disabled\"")>
                        Rechazar solicitud completa
                    </button>
                    <button type="button" class="sil-btn sil-btn-navy sil-btn-block" id="btnCrearCupo" @(esEditable ? "" : "disabled=\"disabled\"")>
                        + Crear nuevo cupo
                    </button>
                </div>
            </div>

            <!-- Panel derecho: Cupos compatibles (placeholder) -->
            <div class="col-5">
                <div class="sil-section-title sil-section-title-success">
                    Cupos compatibles — <span id="lblCantidadCupos">0</span> encontrado(s)
                </div>
                <div class="sil-cupos-panel">
                    <p class="text-muted" style="margin-bottom: 8px;">
                        <i class="fa-solid fa-circle-info"></i>
                        Próximamente: motor de matching.
                    </p>
                    <p class="text-muted" style="font-size: 11.5px;">
                        Al hacer clic en una fila de la izquierda se actualizarán los cupos compatibles
                        para los días seleccionados.
                    </p>
                </div>
                <div class="sil-actions sil-actions-bottom">
                    <button type="button" class="sil-btn" id="btnCancelarCupo">Cancelar</button>
                    <button type="button" class="sil-btn sil-btn-teal" id="btnConfirmarAsignacion" disabled="@(!esEditable ? true : false)">
                        Confirmar asignación seleccionada
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        $(function () {
            var esEditable = @((esEditable ? "true" : "false"));
            var idSolicitud = @(Model != null ? Model.IdSolicitud : 0);

            // ---- Helpers ----

            // Calcula el estado del badge de una fila en función de los valores
            // TR/TO y del estado del checkbox. Tres valores posibles:
            //   - "Seleccionado" (asig/verde) → si el operador tildó el checkbox
            //   - "Pendiente"   (pending/ámbar) → si hay TR>0 o TO>0 y NO está tildado
            //   - "Sin solicitudes" (empty/gris) → si TR==0 && TO==0
            function actualizarEstadoFila($tr) {
                var $chk = $tr.find('.chkDia');
                var tr = parseInt($tr.find('td').eq(2).text(), 10) || 0;
                var toFuturas = parseInt($tr.find('td').eq(3).text(), 10) || 0;
                var $badge = $tr.find('td').eq(4).find('.sil-badge');

                if ($chk.is(':checked')) {
                    $badge.removeClass('sil-badge-pending sil-badge-empty')
                          .addClass('sil-badge-asig')
                          .text('Seleccionado')
                          .attr('data-estado', 'seleccionado');
                } else if (tr > 0 || toFuturas > 0) {
                    $badge.removeClass('sil-badge-asig sil-badge-empty')
                          .addClass('sil-badge-pending')
                          .text('Pendiente')
                          .attr('data-estado', 'pendiente');
                } else {
                    $badge.removeClass('sil-badge-asig sil-badge-pending')
                          .addClass('sil-badge-empty')
                          .text('Sin solicitudes')
                          .attr('data-estado', 'vacio');
                }
            }

            function recalcularResumenSeleccion() {
                var $checked = $('.chkDia:checked');
                var cnt = $checked.length;
                var total = 0;
                $checked.each(function () {
                    var tr = parseInt($(this).closest('tr').find('td').eq(2).text(), 10) || 0;
                    total += tr;
                });
                $('#lblDiasSeleccionados').text(cnt + ' día(s) seleccionado(s) · Total: ' + total + ' TR');
                $('#lblCantidadSeleccion').text(cnt + ' día(s) seleccionado(s)');
                $('#btnConfirmarAsignacion').prop('disabled', cnt === 0 || !esEditable);
                // placeholder: cantidad de cupos = cantidad de días seleccionados.
                $('#lblCantidadCupos').text(cnt);
            }

            // Estado inicial de cada fila + resumen.
            $('#tablaDias tbody tr').each(function () { actualizarEstadoFila($(this)); });
            recalcularResumenSeleccion();

            // Modo readonly: deshabilita todos los controles editables del panel principal.
            if (!esEditable) {
                $('#tablaDias input, #tablaDias button, .sil-actions-block button, #btnConfirmarAsignacion')
                    .prop('disabled', true);
            }

            // Click en checkbox de fila → recalcular estado + resumen.
            $('#tablaDias').on('change', '.chkDia', function () {
                actualizarEstadoFila($(this).closest('tr'));
                recalcularResumenSeleccion();
            });

            // ---- Botonera ----

            // POST genérico con manejo de success/error.
            function postJSON(url, data) {
                return $.ajax({
                    url: url,
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data)
                });
            }

            function manejarRespuesta(resp) {
                if (resp && resp.success) {
                    Swal.fire({ icon: 'success', title: 'Listo', text: resp.message, timer: 1500, showConfirmButton: false })
                        .then(function () { window.location = resp.redirectUrl || '/Solicitudes/Index'; });
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: (resp && resp.message) || '—' });
                }
            }

            // "Rechazar solicitud completa"
            $('#btnRechazarCompleta').on('click', function () {
                if (idSolicitud <= 0) {
                    Swal.fire({ icon: 'error', title: 'Sin id de solicitud' });
                    return;
                }
                Swal.fire({
                    icon: 'warning',
                    title: '¿Rechazar solicitud completa?',
                    text: 'Esta acción rechaza la solicitud para todos los días.',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, rechazar',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: '#a93226'
                }).then(function (res) {
                    if (!res.isConfirmed) return;
                    postJSON('/Solicitudes/RechazarSolicitud', idSolicitud)
                        .done(manejarRespuesta)
                        .fail(function (xhr) {
                            Swal.fire({ icon: 'error', title: 'Error', text: xhr.statusText || 'Fallo de red' });
                        });
                });
            });

            // "+ Crear nuevo cupo" (placeholder)
            $('#btnCrearCupo').on('click', function () {
                Swal.fire({ icon: 'info', title: 'Crear nuevo cupo', text: 'Próximamente: alta manual de cupo.' });
            });

            // "Confirmar asignación seleccionada"
            $('#btnConfirmarAsignacion').on('click', function () {
                var fechas = {};
                $('.chkDia:checked').each(function () {
                    var $tr = $(this).closest('tr');
                    var key = $tr.data('fecha');
                    var tr = parseInt($tr.find('td').eq(2).text(), 10) || 0;
                    fechas[key] = tr;
                });
                if (Object.keys(fechas).length === 0) {
                    Swal.fire({ icon: 'info', title: 'Sin selección', text: 'Tildá al menos un día.' });
                    return;
                }
                postJSON('/Solicitudes/ConfirmarAsignacionSeleccionada', {
                    idSolicitud: idSolicitud,
                    cupoCompatibleId: null,
                    fechas: fechas
                })
                    .done(manejarRespuesta)
                    .fail(function (xhr) {
                        Swal.fire({ icon: 'error', title: 'Error', text: xhr.statusText || 'Fallo de red' });
                    });
            });

            // "Cancelar" del panel derecho
            $('#btnCancelarCupo').on('click', function () {
                window.location = '@Url.Action("Index", "Solicitudes")';
            });
        });
    </script>
}
