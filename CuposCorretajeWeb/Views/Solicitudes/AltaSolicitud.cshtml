@using CuposCorretajeWeb.Models.Solicitudes
@using Newtonsoft.Json;
@model SolicitudViewModel
@{
    ViewBag.Title = "AltaSolicitud";

    var nombreGrano = (Model != null && Model.NombreGrano != null) ? Model.NombreGrano : "";
    var solicitante = (Model != null && Model.Solicitante != null) ? Model.Solicitante : "";
    var comprador = (Model != null && Model.Comprador != null) ? Model.Comprador : "";
    var zona = (Model != null && Model.Zona != null) ? Model.Zona : "";
    var fechas = Model != null ? Model.Fechas : null;
}

<div class="container-fluid">
    <div class="col-12" style="display:flex">
        <div class="col-6">
            <div class="card">
                <div class="card-body">
                    <div class="col-12">
                        <h2>Solicitudes</h2>
                        <div class="row">
                            <div class="col-6">
                                <label class="control-label">Fecha</label>
                                <input type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-6">
                                <label class="control-label">Producto</label>
                                @Html.TextBoxFor(x => x.NombreGrano, new { @class = "form-control", @disabled = "disabled" })
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-12">
                                <label class="control-label">Vendedor/Solicitante</label>
                                @Html.TextBoxFor(x => x.CuentaVendedor, new { @class = "form-control", @disabled = "disabled" })
                                <small class="form-text text-primary fw-bold d-flex justify-content-end">@solicitante</small>
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-11">
                                <label class="control-label">Comprador</label>
                                @Html.DropDownListFor(x => x.CuentaComprador, (IEnumerable<SelectListItem>)ViewBag.Compradores, "Seleccione comprador", new { @class = "form-select form-control" })
                                <small class="form-text text-primary fw-bold d-flex justify-content-end" id="nombreComprador">@comprador</small>
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-10">
                                <label class="control-label">Zona Portuaria</label>
                                @Html.DropDownListFor(x => x.Zona, (IEnumerable<SelectListItem>)ViewBag.ZonaPortuaria, zona ?? "Seleccione Zona", new { @class = "form-select form-control" })
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
                                <table id="tablaAltaSolicitud" class="table table-sm table-hover table-bordered display" style="font-size: 0.9rem;width:100%;">
                                    <thead>
                                        <tr>
                                            <th>Día</th>
                                            <th>Cantidad</th>
                                            <th>Selección</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int dia = 0; dia < 7; dia++)
                                        {
                                            var fecha = DateTime.Now.AddDays(dia).Date;
                                            var fechaKey = fecha.ToString("yyyy-MM-dd"); // mismo formato que en el diccionario
                                            var cantidad = (fechas != null && fechas.ContainsKey(fechaKey)) ? fechas[fechaKey] : 0;
                                            <tr>
                                                <td class="text-center">@fecha.ToString("dd/MM/yyyy")</td>
                                                <td class="text-center">@cantidad</td>
                                                <td style="text-align: center; vertical-align: middle;">
                                                    <input type="checkbox" class="chkFechaSolicitud form-check-input" style="transform: scale(1.3); margin: 0;" data-dia="@fechaKey" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 d-flex justify-content-end">
                                <button class="btn btn-primary" type="button" id="btnSiguientePanelTurnos">Siguiente</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Leyenda cuando Turnos está oculto -->
        <div id="mensajeTurnos" class="col-6 d-flex align-items-center justify-content-center border border-secondary rounded p-4 text-muted">
            <h5>Haga clic en <strong>Siguiente</strong> para continuar.</h5>
        </div>
        <!-- Panel derecho: Turnos -->
        <div id="panelTurnos" class="col-6 d-none">
            <div class="card">
                <div class="card-body">
                    <div class="col-12">
                        <h2>Turnos</h2>
                        <div class="row">
                            <div class="col-6">
                                <label class="control-label">Fecha</label>
                                <input type="date" id="inputFechaTurno" class="form-control" />
                            </div>
                            <div class="col-6">
                                <label class="control-label">Producto</label>
                                @Html.TextBoxFor(x => x.NombreGrano, new { @class = "form-control", @disabled = "disabled" })
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-11">
                                <label class="control-label">Comprador</label>
                                @Html.TextBox("NombreComprador", comprador, new {@class = "form-control", @disabled = "disabled", id = "inputNombreComprador"})
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
                                <table id="tablaAltaSolicitud" class="table table-sm table-hover table-bordered display" style="font-size: 0.9rem;width:100%;">
                                    <thead>
                                        <tr>
                                            <th>Destino</th>
                                            <th>Turnos Disp.</th>
                                            <th>Selección</th>
                                            <th>CCPP</th>
                                            <th>Turnos Rest.</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @*@for (int dia = 0; dia < 7; dia++)
                                            {
                                                var fecha = DateTime.Now.AddDays(dia).Date;
                                                var fechaKey = fecha.ToString("yyyy-MM-dd"); // mismo formato que en el diccionario
                                                var cantidad = (fechas != null && fechas.ContainsKey(fechaKey)) ? fechas[fechaKey] : 0;
                                                <tr>
                                                    <td class="text-center">@fecha.ToString("dd/MM/yyyy")</td>
                                                    <td class="text-center">@cantidad</td>
                                                    <td style="text-align: center; vertical-align: middle;">
                                                        <input type="checkbox" class="form-check-input" style="transform: scale(1.3); margin: 0;" data-dia="@fechaKey" />
                                                    </td>
                                                </tr>
                                            }*@
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-12 d-flex justify-content-end">
                                <button class="btn btn-primary" type="submit">Aceptar</button>
                                <button class="btn btn-danger ml-2">Cancelar</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            $('#btnSiguientePanelTurnos').on('click', function () {
                // Obtener fecha seleccionada o actual
                const $chkFecha = $('.chkFechaSolicitud:checked').first();
                let fechaSeleccionada = $chkFecha.length > 0 ? $chkFecha.data('dia') : new Date().toISOString().split('T')[0]; // Fecha actual en formato YYYY-MM-DD

                // Actualizar input y mostrar panel
                $('#inputFechaTurno').val(fechaSeleccionada); // setea en input
                $('#panelTurnos').removeClass('d-none');       // muestra panel
                $('#mensajeTurnos').removeClass('d-flex').addClass('d-none').hide(); // oculta leyenda
            });

            var compradorMap = @Html.Raw(ViewBag.CompradorMap);
            // Actualizar nombre al cambiar selección
            $('#CuentaComprador').on('change', function () {
                const nombre = compradorMap[$(this).val()] || '';

                // Actualiza ambos lugares
                $('#nombreComprador').text(nombre);       // Small del primer panel
                $('#inputNombreComprador').val(nombre);   // Input del panel derecho
            });

            // Actualizar al cargar la página
            const cuentaInicial = $('#CuentaComprador').val();
            const nombreInicial = compradorMap[cuentaInicial] || '@comprador';

            $('#nombreComprador').text(nombreInicial);
            $('#inputNombreComprador').val(nombreInicial);
        });

    </script>
}

